#!/bin/sh
# The gates, moved in front of the commit.
#
# Why this exists: every check in this repository is a check that a human has to
# remember to run. A check that depends on being remembered is a check with a
# silent failure mode of its own — the run where you forget looks exactly like
# the run where everything passed.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Design rules, each of which is a defect this repository has already recorded:
#
#   1. The interpreter is discovered, never hard-coded. A committed absolute
#      path is a leak of the machine it was written on, and it breaks for
#      everyone else.
#   2. If no interpreter can be found, the hook FAILS. "I could not run the
#      check" is not "the check passed". Set PYTHON to point at one explicitly.
#   3. Nothing is swallowed. No `|| true`, no output redirection to /dev/null.
#   4. A missing gate script is a failure, not a skip.
#   5. Nothing in this list names a version. The release gate reads the canonical
#      ref out of README.md. A hard-coded tag here is a second source of truth, and
#      it goes stale the moment the anchor moves (2026-10-07 -- the literal
#      `--ref v0.1.0` sat in three call sites at once).
#
#   2026-10-08: gate 12 joins -- tools/impl-mutation.py systematically mutates
#   implementation.py itself (five first-order operator classes) and requires
#   every non-equivalent mutant to be killed by the S5 selftest; the artifact
#   under test is now watched at the source level, not only around it.
#   2026-10-07: gate 10 joins -- tools/defect-closure.py reads docs/defect-ledger.json
#   and fails if any recorded defect is open or missing evidence. It makes "a report
#   was actually closed out" a checked property, so a correction cannot be answered
#   by editing only the named site (rule 14).
#   2026-10-07: gate 9 joins -- tools/checker-mutation.py mutates the harness's
#   own checks and requires each mutation to break the S5 selftest, so "our
#   checks can fail" is a checked property rather than a claim. (Review round 3
#   found a gate that had never been shown to fail.)
#   2026-10-06: the S5-Qregister selftest joins gate 8 (mirroring CI).
#   2026-09-30: the list below was extended to match CI gate-for-gate
#   (release consistency + the examples/T08-S5Q2 selftest with its
#   mutation suite). The two lists had already drifted -- CI ran six
#   gates while this hook ran five -- which is the exact shape of the
#   failures this repository catalogs.

set -u

cd "$(dirname "$0")/.." || exit 1

if [ -n "${PYTHON:-}" ]; then
    py="$PYTHON"
    if [ ! -x "$py" ] && ! command -v "$py" >/dev/null 2>&1; then
        echo "pre-commit: PYTHON is set to '$py' but that is not executable." >&2
        echo "pre-commit: refusing to commit — an unrunnable check is not a passed check." >&2
        exit 1
    fi
else
    py=""
    for cand in python3 python; do
        if command -v "$cand" >/dev/null 2>&1; then py="$cand"; break; fi
    done
    if [ -z "$py" ]; then
        echo "pre-commit: no Python interpreter found (looked for python3, python)." >&2
        echo "pre-commit: refusing to commit. Install Python, or set PYTHON=/path/to/python." >&2
        exit 1
    fi
fi

fail=0

run() {
    label="$1"; shift
    script="$1"; shift
    if [ ! -f "$script" ]; then
        echo "pre-commit: FAIL — $script is missing. A gate that is not there is not a gate." >&2
        fail=1
        return
    fi
    if ! out=$("$py" "$script" "$@" 2>&1); then
        echo "pre-commit: FAIL — $label" >&2
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        fail=1
    fi
}

run "gate-lint selftest"        tools/gate-lint.py     --selftest
run "catalog selftest"          tools/check-catalog.py --selftest
run "catalog consistency"       tools/check-catalog.py
run "de-identification scan"    tools/check-catalog.py --scan-leaks
run "content manifest"          tools/make-manifest.py --check
run "release consistency"       tools/verify_release_consistency.py --repo-path . --no-remote
run "examples selftest"         examples/T08-S5Q2/simulation.py --selftest
run "blinded example selftest"  examples/S5-Qregister/simulation.py --selftest
run "checker mutation"          tools/checker-mutation.py
run "defect closure"            tools/defect-closure.py
run "defect closure selftest"   tools/defect-closure.py --selftest
run "implementation mutation"   tools/impl-mutation.py

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: commit blocked. Fix the above, or if the manifest is stale:" >&2
    echo "            $py tools/make-manifest.py" >&2
    exit 1
fi

echo "pre-commit: all gates passed."
exit 0
