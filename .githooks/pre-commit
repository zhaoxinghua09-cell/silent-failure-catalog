#!/bin/sh
# The gates, moved in front of the commit.
#
# Why this exists: every check in this repository is a check that a human has to
# remember to run. A check that depends on being remembered is a check with a
# silent failure mode of its own — the run where you forget looks exactly like
# the run where everything passed.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Design rules, each of which is a defect this repository has already recorded:
#
#   1. The interpreter is discovered, never hard-coded. A committed absolute
#      path is a leak of the machine it was written on, and it breaks for
#      everyone else.
#   2. If no interpreter can be found, the hook FAILS. "I could not run the
#      check" is not "the check passed". Set PYTHON to point at one explicitly.
#   3. Nothing is swallowed. No `|| true`, no output redirection to /dev/null.
#   4. A missing gate script is a failure, not a skip.
#   5. Nothing in this list names a version. The release gate reads the canonical
#      ref out of README.md. A hard-coded tag here is a second source of truth, and
#      it goes stale the moment the anchor moves (2026-10-07 -- the literal
#      `--ref v0.1.0` sat in three call sites at once).
#   6. THIS LIST IS THE ONLY PLACE A GATE IS DESCRIBED. Every `run` line carries
#      the gate's name and, in the second field, the parenthetical that the CI
#      step will show. `.github/workflows/gates.yml` no longer holds a hand-
#      written copy of these steps; the block there is generated from this file
#      and gate 15 fails if the two disagree (see the 2026-10-08 entry below).
#
# 2026-10-09: gate 17 joins -- tools/verify_release_face.py. Gate 6 compares one
#   sentence in README against one sentence in INTEGRITY and nothing else; it has
#   no opinion about .zenodo.json, CITATION.cff, llms.txt or
#   docs/where-to-find-us.md. Reading the published artifacts on 2026-10-09 found
#   four faces of this release disagreeing with the README and no gate able to see
#   any of them (llms.txt and where-to-find-us said 0.1.0 while the canonical tag
#   was v0.1.1; INTEGRITY's Zenodo line said 0.1.0; Zenodo held only 0.1.0 and no
#   Release had ever been published for v0.1.1). Gate 17 is the in-tree half: the
#   release version, both DOIs, the archived version label and the release date
#   must agree across every file that declares them. It never skips -- a claim
#   that cannot be read is a failure, not a pass. The published half (tag,
#   Release, Zenodo record, branch protection) cannot be answered at commit time
#   and runs instead in `.github/workflows/release-face-remote.yml`, on a daily
#   schedule and on every published release.
# 2026-10-09: the CI form of gate 6 gains `--allow-absent-canonical-tag`. The
#   strict form ("the declared canonical tag must resolve") is a *release-time*
#   property, and `gates · python 3.9/3.12` are required checks on `main` -- so
#   enforced at pull-request time it blocks the version bump that creates the tag.
#   Measured: branch protection lists both matrix jobs as required, with
#   `strict: true` and `enforce_admins: true`. The flag tolerates exactly one
#   condition (a 404 on the canonical ref), prints it as "not yet released"
#   instead of passing quietly, and leaves every other resolution error failing.
#   The order this buys is written down in docs/pull-request-workflow.md: a
#   version bump and its tag land together.
# 2026-10-08: the CI step block is now GENERATED from this file. Before this,
#   the two lists were two hand-written copies, and the shapes that defeated the
#   comparison were measured -- a gate added to both lists, a gate's arguments
#   changed on both sides, a gate deleted from both and the labels renumbered.
#   Generating the CI side closes the first two structurally: there is no longer
#   a place to add a gate that this file does not have.
#   WHAT IT DOES NOT CLOSE, stated plainly: a gate deleted from THIS file and
#   then regenerated is still invisible, because both sides agree again -- the
#   comparison only ever sees one source. Closing that needs a second registry
#   of expected gates, which is the second source of truth this repository
#   forbids. Measured as control N7 in tools/check-gate-parity.py --selftest;
#   that control is expected to stay green, and it is not a selling point.
#   2026-10-08: gates 14 and 15 join -- tools/check-gate-parity.py is the first
#   gate that watches the gate list itself. This hook is the specification and
#   `.github/workflows/gates.yml` is its echo, but nothing compared the two:
#   the 2026-09-30 drift (this list ran five gates while CI ran six) was found
#   by a human counting, which is the failure shape this repository catalogs,
#   one level up. Gate 14 runs the checker's own selftest -- a parity gate that
#   cannot fail would be that same defect again. Gate 15 compares the two real
#   lists and fails on a missing gate, a changed argument, or a stale `N/M`
#   label. The single declared difference (gate 6 runs offline here and with an
#   API token in CI) is written as a `# ci-only:` override on gate 6, so editing
#   either side breaks the override instead of quietly widening it.
#   2026-10-08: gate 13 joins -- tools/check-line-endings.py scans the INDEX
#   blobs for CRLF. `.gitattributes` is `* -text`, so git performs no
#   end-of-line conversion at all: without this gate a CRLF file enters the
#   index, is committed, and every manifest digest still matches, because the
#   bytes are byte-exact on checkout. It reads the index and never the working
#   tree -- a tree normalized to LF looks green while the index still holds the
#   CRLF the next commit would record (D-021).
#   2026-10-08: gate 16 joins -- tools/prepare.py --selftest. prepare.py's
#   *pipeline* must never be listed here: it calls this hook, so listing it
#   would recurse, and the PREPARE_ACTIVE sentinel turns that into a refusal
#   instead of a hang. Its `--selftest` is the other half -- it builds its own
#   throw-away repositories and never calls this hook. Until it joined, the
#   thirteen things prepare.py claims it can fail at were enforced by nothing:
#   prose about a tool, which is the shape this repository keeps finding one
#   level up. It costs about eight seconds. One consequence is worth writing
#   down: the selftest clears PREPARE_ACTIVE for its own duration, because it
#   calls main(), which is where the sentinel is checked -- without that, gate
#   16 would go red every time prepare.py ran its own verify, deadlocking the
#   tool against the gate list it exists to satisfy.
#   2026-10-08: gate 12 joins -- tools/impl-mutation.py systematically mutates
#   implementation.py itself (five first-order operator classes) and requires
#   every non-equivalent mutant to be killed by the S5 selftest; the artifact
#   under test is now watched at the source level, not only around it.
#   2026-10-07: gate 10 joins -- tools/defect-closure.py reads docs/defect-ledger.json
#   and fails if any recorded defect is open or missing evidence. It makes "a report
#   was actually closed out" a checked property, so a correction cannot be answered
#   by editing only the named site (rule 14).
#   2026-10-07: gate 9 joins -- tools/checker-mutation.py mutates the harness's
#   own checks and requires each mutation to break the S5 selftest, so "our
#   checks can fail" is a checked property rather than a claim. (Review round 3
#   found a gate that had never been shown to fail.)
#   2026-10-06: the S5-Qregister selftest joins gate 8 (mirroring CI).
#   2026-09-30: the list below was extended to match CI gate-for-gate
#   (release consistency + the examples/T08-S5Q2 selftest with its
#   mutation suite). The two lists had already drifted -- CI ran six
#   gates while this hook ran five -- which is the exact shape of the
#   failures this repository catalogs.

set -u

cd "$(dirname "$0")/.." || exit 1

if [ -n "${PYTHON:-}" ]; then
    py="$PYTHON"
    if [ ! -x "$py" ] && ! command -v "$py" >/dev/null 2>&1; then
        echo "pre-commit: PYTHON is set to '$py' but that is not executable." >&2
        echo "pre-commit: refusing to commit — an unrunnable check is not a passed check." >&2
        exit 1
    fi
else
    py=""
    for cand in python3 python; do
        if command -v "$cand" >/dev/null 2>&1; then py="$cand"; break; fi
    done
    if [ -z "$py" ]; then
        echo "pre-commit: no Python interpreter found (looked for python3, python)." >&2
        echo "pre-commit: refusing to commit. Install Python, or set PYTHON=/path/to/python." >&2
        exit 1
    fi
fi

fail=0

# run <name> <ci-note> <script> [args...]
#
#   <name>     shown when this gate fails, and used verbatim as the CI step name
#   <ci-note>  the CI step's parenthetical, or "" when the name says enough.
#              Consumed here and not printed: it exists so that the whole
#              description of a gate lives on the gate's own line.
run() {
    name="$1"; shift 2
    script="$1"; shift
    if [ ! -f "$script" ]; then
        echo "pre-commit: FAIL — $script is missing. A gate that is not there is not a gate." >&2
        fail=1
        return
    fi
    if ! out=$("$py" "$script" "$@" 2>&1); then
        echo "pre-commit: FAIL — $name" >&2
        printf '%s\n' "$out" | sed 's/^/    /' >&2
        fail=1
    fi
}

run "gate-lint selftest"          "" tools/gate-lint.py     --selftest
run "catalog selftest"            "" tools/check-catalog.py --selftest
run "catalog consistency"         "indexes, the six targets, link discipline" tools/check-catalog.py
run "de-identification scan"      "" tools/check-catalog.py --scan-leaks
run "content manifest"            "" tools/make-manifest.py --check

# The hook stays offline by design; CI resolves the canonical tag through the API,
# which needs --repo <owner/repo> and GH_TOKEN. This is the one gate the two sides
# run differently, and the difference is declared on the gate rather than in a
# table inside the checker.
# ci-only: tools/verify_release_consistency.py --repo-path . --repo "${{ github.repository }}" --allow-absent-canonical-tag
run "release consistency"         "canonical anchor resolves · manifest matches" tools/verify_release_consistency.py --repo-path . --no-remote

run "release face"                "one version, told the same way on every face" tools/verify_release_face.py --repo-path . --no-remote

run "examples selftest"           "T08-S5Q2 cases + mutation suite" examples/T08-S5Q2/simulation.py --selftest
run "blinded example selftest"    "S5-Qregister blinded run + mutation suite" examples/S5-Qregister/simulation.py --selftest
run "checker mutation"            "the checks themselves must be able to fail" tools/checker-mutation.py
run "defect closure"              "every recorded correction is closed with evidence" tools/defect-closure.py
run "defect closure selftest"     "that gate must be able to fail too" tools/defect-closure.py --selftest
run "implementation mutation"     "source-level watch on the artifact under test" tools/impl-mutation.py
run "line endings"                "the index carries no CRLF" tools/check-line-endings.py
run "gate parity selftest"        "that gate must be able to fail too" tools/check-gate-parity.py --selftest
run "gate parity hook-vs-ci"      "the hook and this file run the same gates" tools/check-gate-parity.py
run "prepare selftest"            "the ordering and its limits must be able to fail" tools/prepare.py --selftest

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: commit blocked. Fix the above, or if the manifest is stale:" >&2
    echo "            $py tools/make-manifest.py" >&2
    exit 1
fi

echo "pre-commit: all gates passed."
